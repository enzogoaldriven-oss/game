# Bot ingest secret. Required in production.
# In `next dev`, an unset secret falls back to dev-crew-secret.
CREW_HQ_SECRET=change-me-to-a-long-random-string

# Viewer password for the page, the activity log, and the live stream.
# Required in production. In `next dev`, an unset password falls back to dev-viewer.
# POST /api/events does not use this password. Bots keep using CREW_HQ_SECRET.
CREW_HQ_VIEW_PASSWORD=change-me-to-a-viewer-password
